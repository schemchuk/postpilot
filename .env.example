# HeyGen API (video avatar)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Claude API (generation, translation)
ANTHROPIC_API_KEY=

# LinkedIn app (reused; own OAuth token is obtained by postpilot itself)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=
LINKEDIN_REDIRECT_URI=
# Threads app (leave redirect URI blank to reuse the LinkedIn callback)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=
# One-time import only. The CLI reads this from its process environment.
THREADS_ACCESS_TOKEN=

DATABASE_URL=

# Telegram bot (approval and alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Telegram webhook secret (also passed to setWebhook)
TELEGRAM_WEBHOOK_SECRET=
# Fine-grained GitHub PAT limited to postpilot with Actions read/write
GITHUB_DISPATCH_TOKEN=
# Optional webhook dispatch repository (defaults to schemchuk/postpilot)
# GITHUB_REPOSITORY=schemchuk/postpilot

TOKEN_ENCRYPTION_KEY=

# Optional short links and repository traffic snapshots
SHORTIO_API_KEY=
SHORTIO_DOMAIN=
GITHUB_OWNER=schemchuk
GITHUB_TOKEN=

# Optional HeyGen video settings
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_ENGINE=avatar_iv
VIDEO_MONTHLY_CAP=6
VIDEO_MIN_BALANCE_USD=3.0

# Facebook Reels. Import the Page token once into the encrypted token store.
FACEBOOK_PAGE_ID=
# Graph API version shared by Facebook and Instagram Reels.
FACEBOOK_GRAPH_VERSION=v27.0
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Reels (optional)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Gmail IMAP for LinkedIn notification emails (T15a)
IMAP_USER=
IMAP_PASSWORD=
# cron-job.org REST API key (only for managing the trigger jobs, not used by the app)
CRONJOB_API_KEY=

# YouTube Shorts (runbook: YouTube Shorts setup)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok (runbook: TikTok setup)
TIKTOK_ENV=sandbox
# TikTok publishing mode: draft or direct
TIKTOK_MODE=draft
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_SANDBOX_CLIENT_KEY=
TIKTOK_SANDBOX_CLIENT_SECRET=
TIKTOK_SANDBOX_REFRESH_TOKEN=
